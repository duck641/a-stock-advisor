# ═══════════════════════════════════════════════════════════════
# A_stock 配置文件模板
#
# 使用步骤：
#   1. cp .env.example .env
#   2. 至少填 LLM_PROVIDER + LLM_API_KEY
#   3. 按需调整其他参数（全都有注释和推荐值）
# ═══════════════════════════════════════════════════════════════


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 一、LLM 连接配置（必填）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 厂商标识
# 可选值：deepseek | openai | qwen | glm | moonshot | ollama
# 填了之后 model / base_url / context_window 自动补齐，无需手动配
LLM_PROVIDER=deepseek

# API 密钥（ollama 不需要）
LLM_API_KEY=***

# ─── 以下为可选覆盖项（填了就用自己的，不填就用提供商默认值） ───

# 模型名称（覆盖提供商的默认模型）
#LLM_MODEL=deepseek-chat

# API 端点（自定义厂商时必填，或用此覆盖预设端点）
#LLM_BASE_URL=https://api.deepseek.com/v1


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 二、LLM 行为参数（必填）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 生成温度（0-2，越高越随机 / 越低越保守）
LLM_TEMPERATURE=0.7

# 单次最大输出 token 数
LLM_MAX_TOKENS=***


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 三、对话上下文管理（可选，有默认值）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 模型上下文窗口大小（不填则根据 LLM_PROVIDER 自动设置）
#LLM_CONTEXT_WINDOW=65536

# 触发历史压缩的 token 占比（0-1）
# 比如填 0.6 → 对话占满 60% 上下文窗口时自动压缩
LLM_COMPRESSION_RATIO=0.6
