# A_stock 配置文件模板
# 复制为 .env 后填写密钥，或运行 `a-stock setup`。

# 一、LLM 连接
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com/v1

# 二、LLM 行为参数
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_MAX_AGENT_STEPS=16

# 三、上下文管理
LLM_CONTEXT_WINDOW=1000000
LLM_COMPRESSION_RATIO=0.6
